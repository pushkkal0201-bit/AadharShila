# Development configuration ONLY. Change the session secret before any shared deployment.
APP_ENV=development
SEED_DEMO=true
SESSION_SECRET=change-this-long-random-development-secret
DATABASE_URL=postgresql+psycopg://aadharshila:aadharshila_dev@db:5432/aadharshila
UPLOAD_DIR=/app/var/documents

# Partner gateway integration is opt-in and requires authorized provider onboarding.
# All URLs must be fixed HTTPS hosts explicitly listed here; never include untrusted URLs.
AADHARSHILA_PARTNER_ALLOWED_HOSTS=
# Example (do not configure without an authorized partner gateway contract):
# AADHARSHILA_PARTNER_BANK_INCOME_URL=https://gateway.example.org/evidence
# AADHARSHILA_PARTNER_BANK_INCOME_MODE=SANDBOX
# AADHARSHILA_PARTNER_BANK_INCOME_NAME=your-authorized-partner
# AADHARSHILA_PARTNER_BANK_INCOME_TOKEN=your-partner-secret-token
# AADHARSHILA_PARTNER_BANK_INCOME_HMAC_KEY=your-partner-response-signing-secret
